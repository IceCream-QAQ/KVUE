<idea-plugin>
    <id>org.kvue.idea</id>
    <name>KVUE</name>
    <vendor>KVUE</vendor>
    <description>Create KVUE projects and edit live Kotlin declarations for Vue components. Builds continue to use KSP.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="kvue-gradle.xml">com.intellij.gradle</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
        <kaResolveExtensionProvider implementation="kvue.idea.KvueResolveExtensionProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler implementation="kvue.idea.KvueGotoDeclarationHandler" order="first"/>
        <annotator language="kotlin" implementationClass="kvue.idea.KvueBindingAnnotator"/>
        <postStartupActivity implementation="kvue.idea.KvueStartupActivity"/>
    </extensions>
    <actions>
        <group id="KVUE.Tools" text="KVUE" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="KVUE.Refresh" class="kvue.idea.RefreshKvueDeclarationsAction" text="Refresh Component Declarations"/>
            <action id="KVUE.Status" class="kvue.idea.KvueAnalysisStatusAction" text="Show Analysis Status"/>
        </group>
    </actions>
</idea-plugin>
